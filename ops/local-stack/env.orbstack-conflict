# Copy to ops/local-stack/.env to use while OrbStack.app is running.
#
# OrbStack.app holds 127.0.0.1 5432, 6379, 9200, 9324 and 9000. It keeps those listeners even when
# it owns no container on them, so a Colima stack publishing the standard ports looks healthy from
# `docker compose ps` while every host connection is silently answered by OrbStack instead.
#
# This file shifts each host port to a free neighbour. Container-side ports are unchanged, so the
# service configuration inside the network is identical.
#
# Delete this file (or quit OrbStack) to go back to the standard ports.

DOCSURI_PG_HOST_PORT=15432
DOCSURI_REDIS_HOST_PORT=16379
DOCSURI_OPENSEARCH_HOST_PORT=19200
DOCSURI_ELASTICMQ_HOST_PORT=19324
DOCSURI_S3_HOST_PORT=19000
DOCSURI_SEAWEED_MASTER_HOST_PORT=19333
DOCSURI_SEAWEED_VOLUME_HOST_PORT=18080
