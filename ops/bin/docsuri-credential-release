#!/Library/DocSuri/release/.venv/bin/python -I
"""docsuri-credential-release: release one operator-tool login (D5).

Run as root through sudo, in person, with one login's name (operator, restore or
platform). It serves only the account sudo authenticated (SUDO_UID) when that account is
the installed operator named in the root-owned control/platform-authorities.json; root
without sudo and every other account are refused before the keychain is read (D4). It
reads that System keychain item and writes the password to standard output, the pipe the
operator tool opened, and its one JSON result, naming that account, to standard error.
It refuses to run when the environment holds PYTHON*, DYLD_* or LD_* variables.
"""

import sys

if sys.argv[1:] == ["--self-check"]:
    from docsuri_ops.release import self_check

    raise SystemExit(self_check(__file__))

from docsuri_ops.u8_platform.fixed import main_fixed

raise SystemExit(main_fixed("docsuri-credential-release"))
