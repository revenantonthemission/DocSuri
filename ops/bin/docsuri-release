#!/Library/DocSuri/release/.venv/bin/python -I
"""docsuri-release: install a release, or switch back to the kept one (cicd-pipeline § 5–6,
C1, C2, C9, C10, D4, D6).

Run as root through sudo, in person (`sudo -k`), with one word from its closed set:
`install`, with the tag as bounded JSON on standard input (`{"tag": "v2.0.0"}`), or
`rollback`, with no input. It shows what it will change and asks you to type the
commit's short hash before it touches production. The word is checked again by the
program; one JSON result is written to standard output. It refuses to run when the
environment holds PYTHON*, DYLD_* or LD_* variables. The release's own source roots reach
the interpreter through the root-owned docsuri-release.pth.
"""

import sys

if sys.argv[1:] == ["--self-check"]:
    from docsuri_ops.release import self_check

    raise SystemExit(self_check(__file__))

from docsuri_ops.release import main_fixed

raise SystemExit(main_fixed())
