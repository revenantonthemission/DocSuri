#!/Library/DocSuri/release/.venv/bin/python -I
"""docsuri-logs: the log lines carrying one request identifier, read-only (D11, D13).

Run as root through sudo, in person, with the word `filter` and the request identifier as
bounded JSON on standard input. It reads the fixed per-account log folders and writes one
JSON result with at most 500 matching lines. It refuses to run when the environment holds
PYTHON*, DYLD_* or LD_* variables.
"""

import sys

if sys.argv[1:] == ["--self-check"]:
    from docsuri_ops.release import self_check

    raise SystemExit(self_check(__file__))

from docsuri_ops.u8_platform.fixed import main_fixed

raise SystemExit(main_fixed("docsuri-logs"))
