# 로컬 도구·OS 노이즈 (local tooling / OS noise)
.serena/
.DS_Store
node_modules/
.agents/
.claude/worktrees/
.pnpm-store/

# IDE
.idea/
.vscode/

# 환경변수 (secrets — never commit)
.env
.env.*
!.env.example

# Local secrets
backend/.env
frontend/.env

# Python (shared/python/ binding — backend·ingestion·ops = Python, §5-A)
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.hypothesis/
*.egg-info/
build/
dist/
# uv.lock IS committed (reproducible installs); _generated/ IS committed (drift-checked).

# CDK synth output (build artifact — regenerated by `cdk synth`)
ops/cdk/cdk.out/
# F13 code-generation exclusion lock (persistent inode, no source content).
shared/python/.codegen.lock
platform_integrity/.coverage

# Local diagnostic output (archive useful captures outside the checkout).
*.heapsnapshot
.coverage
.coverage.*
coverage.xml
htmlcov/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# BEGIN AI-DLC:gitignore
# AI-DLC: local working files
aidlc/active-space
aidlc/spaces/*/intents/active-intent
aidlc/.aidlc-clone-id
aidlc.settings.local.json
aidlc/.aidlc-unit-scope.json
aidlc/.aidlc-unit-parked
aidlc/.aidlc-claim-generations.json
aidlc/.aidlc-unit-participant
aidlc/.aidlc-claim-registry.json
aidlc/.aidlc-unit-releases/
aidlc/.aidlc-unit-merges/
aidlc/.aidlc-active-space-*.tmp
aidlc/.aidlc-sessions/
aidlc/spaces/*/intents/.aidlc-*
**/aidlc/spaces/*/intents/**/.aidlc-engine/
**/aidlc/spaces/*/intents/**/.aidlc-sensors/
aidlc/spaces/*/knowledge/documentkb/.journal/
aidlc/spaces/*/knowledge/.sources.local.json
aidlc/spaces/*/intents/*/runtime-graph.json
aidlc/spaces/*/intents/*/.aidlc-*
aidlc/diagnostics/
# END AI-DLC:gitignore
