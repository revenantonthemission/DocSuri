@@ -92,0 +99,29 @@ function statePath(intent: string): string {
+// The orchestrator cannot see its own PID in its ancestry, but its real state
+// child can. This deterministically covers a parent ancestry miss followed by
+// a conflicting child lookup without racing processes or mocking the resolver.
+function parkWithChildOnlyAncestry(
+  tool: string,
+  env: Record<string, string | undefined>,
+): { status: number; out: string } {
+  const source = `
+    import { main } from ${JSON.stringify(pathToFileURL(tool).href)};
+    import { resolveSessionIdFromAncestry, writeSessionPidEntry }
+      from ${JSON.stringify(pathToFileURL(join(dirname(tool), "aidlc-lib.ts")).href)};
+    const projectDir = ${JSON.stringify(proj)};
+    writeSessionPidEntry(projectDir, process.pid, "session-b");
+    if (resolveSessionIdFromAncestry(projectDir) !== null) {
+      throw new Error("Fixture parent unexpectedly has mapped ancestry");
+    }
+    main(["park", "--project-dir", projectDir]);
+  `;
+  const result = Bun.spawnSync({
+    timeout: remainingOperationTimeoutMs(NATIVE_STARTUP_TIMEOUT_MS),
+    cmd: [process.execPath, "--eval", source],
+    stdout: "pipe",
+    stderr: "pipe",
+    cwd: proj,
+    env,
+  });
+  return { status: result.exitCode, out: result.stdout.toString() + result.stderr.toString() };
+}
