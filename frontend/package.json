{
  "name": "docsuri-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "DocSuri U5 Frontend — SSR phone-first web UI (deploy unit ④)",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:u1": "eslint components/PaperDetailIsland.tsx components/JobStatus.tsx components/SummaryModal.tsx components/session/SessionContext.tsx lib/api/contentJobApi.ts lib/api/httpTransport.ts lib/api/routeHandlerTransport.ts lib/api/transport.ts app/bff/\\[...path\\]/route.ts",
    "typecheck": "tsc --noEmit --incremental false",
    "typecheck:u1": "tsc --project tsconfig.u1.json --noEmit --incremental false",
    "gen:types": "node scripts/gen-types.mjs",
    "check:types": "node scripts/gen-types.mjs --check",
    "check:consumers": "node scripts/inventory-consumers.mjs",
    "test:contracts": "vitest run --config vitest.contracts.config.ts",
    "test": "vitest run",
    "test:u1": "vitest run --config vitest.u1.config.ts",
    "test:coverage": "vitest run --coverage",
    "test:coverage:u1": "vitest run --config vitest.u1.config.ts --coverage",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:u1": "playwright test --config playwright.u1.config.ts"
  },
  "dependencies": {
    "@sentry/nextjs": "11.4.0",
    "clsx": "2.1.1",
    "mathjax-full": "^3.2.2",
    "next": "15.5.26",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "server-only": "0.0.1",
    "swr": "2.5.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.55.1",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@testing-library/user-event": "14.5.2",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.10.7",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "@vitejs/plugin-react": "4.7.0",
    "@vitest/coverage-v8": "3.2.6",
    "eslint": "9.18.0",
    "eslint-config-next": "15.5.26",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^4.8.0",
    "jsdom": "25.0.1",
    "json-schema-to-typescript": "15.0.4",
    "prettier": "3.4.2",
    "tailwindcss": "4.3.3",
    "typescript": "5.7.3",
    "typescript-eslint": "^8.71.0",
    "vite": "6.4.3",
    "vitest": "3.2.6"
  },
  "packageManager": "pnpm@9.15.9",
  "pnpm": {
    "overrides": {
      "sharp": "0.35.4",
      "@xmldom/xmldom": "0.9.12",
      "postcss": "^8.5.18",
      "nanoid@3": "^3.3.18",
      "browserslist": "^4.28.7",
      "brace-expansion@1": "1.1.20",
      "brace-expansion@5": "5.0.11",
      "js-yaml@4": "4.3.2"
    }
  }
}
