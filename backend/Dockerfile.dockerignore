# Build-context companion to the U1 Dockerfile. Deny by default so COPY of a
# domain directory never imports an operator file, local environment or evidence.
*
!shared/
!shared/python/
!shared/python/pyproject.toml
!shared/python/README.md
!shared/python/src/
!shared/python/src/**
!platform_integrity/
!platform_integrity/pyproject.toml
!platform_integrity/src/
!platform_integrity/src/**
!platform_integrity/migrations/
!platform_integrity/migrations/*.sql
!ops/
!ops/pyproject.toml
!ops/README.md
!ops/src/
!ops/src/**
!backend/
!backend/pyproject.toml
!backend/uv.lock
!backend/README.md
!backend/*.py
!backend/modules/
!backend/modules/**/
!backend/modules/**/*.py
!backend/modules/**/pyproject.toml
!backend/modules/**/README.md
!backend/modules/**/*.sql
!backend/modules/**/*.json
!backend/migrations/
!backend/migrations/*.py
!backend/middleware/
!backend/middleware/*.py
**/.env
**/.env.*
**/.venv/**
**/node_modules/**
**/__pycache__/**
**/credentials*
**/*.pem
**/*.key
